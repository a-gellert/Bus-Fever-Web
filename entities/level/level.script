-- Level controller: the only script with game flow. Wires sim (rules) <-> views <-> meta/platform.
-- Owns input, level start/restart/advance, boosters, rescue, ads, tutorial. Everything else lives in modules/.
local config = require("modules.config")
local levels = require("modules.meta.levels")
local progress = require("modules.meta.progress")
local ads = require("modules.platform.ads")
local sim_mod = require("modules.sim.sim")
local rules = require("modules.sim.rules")
local solver = require("modules.sim.solver")
local layout = require("modules.view.layout")
local board_view = require("modules.view.board_view")
local queue_view = require("modules.view.queue_view")
local hud_mod = require("modules.view.hud")
local palette = require("modules.view.palette")
local audio = require("modules.view.audio")
local juice = require("modules.view.juice")

local TOUCH = hash("touch")
local PASSENGER_FACTORY = "/level#passenger_factory"
local TILE_FACTORY = "/level#tile_factory"
local FREE_RESCUE_UNTIL = 6 -- levels with one free "+1 slot" rescue
local on_stuck -- defined below; rescue paths reopen the popup when a rescue fails

local function max_bus_len(st)
	local m = 4
	for _, bus in ipairs(st.buses) do m = math.max(m, config.SIZES[bus.size].len) end
	for _, g in ipairs(st.garages) do
		for _, spec in ipairs(g.queue) do m = math.max(m, config.SIZES[spec.size].len) end
	end
	return m
end

local function compute_layout(self)
	local w, h = window.get_size()
	return layout.compute(w, h, self.sim.st.lot, #self.sim.st.bays, max_bus_len(self.sim.st))
end

local function refresh_hud(self)
	local s = {}
	for _, name in ipairs(hud_mod.BOOSTERS) do
		s[name] = {
			count = progress.booster_count(name),
			unlocked = progress.booster_unlocked(name, self.number),
			unlock_level = config.BOOSTERS[name].unlock_level,
			active = name == "vip" and self.vip_mode,
		}
	end
	self.hud:set(s, "LEVEL " .. self.number)
	self.hud:set_coins(progress.coins())
end

local IDLE_HINT = 7        -- seconds without a tap before the hand shows a good move
local IDLE_HINT_UNTIL = 10 -- levels with idle hints

-- Tutorial (levels 1-2 until done) and idle hints: point at a free bus the queue head needs
local function update_tutorial(self)
	local tutorial = self.number <= 2 and not progress.tutorial_done()
	local idle = self.number <= IDLE_HINT_UNTIL and (self.idle or 0) > IDLE_HINT
	if not (tutorial or idle) or self.hud:is_modal() or self.finished then
		self.hud:point(nil)
		return
	end
	local st = self.sim.st
	local head = st.queue[st.head]
	for _, bay in ipairs(st.bays) do
		local b = bay.bus and st.buses[bay.bus]
		if b and b.color == head and b.left > 0 then
			self.hud:point(nil) -- the right bus is already there: let them watch
			return
		end
	end
	local free = {}
	for _, id in ipairs(rules.free_buses(st)) do free[id] = true end
	for _, id in ipairs(rules.parked(st)) do
		local bus = st.buses[id]
		if bus.color == head and free[id] then
			local p = self.board:bus_world_pos(id)
			self.hud:point(p.x, p.y)
			return
		end
	end
	self.hud:point(nil)
end

local function clear(self)
	if self.board then self.board:delete() end
	if self.queue then self.queue:delete() end
	if self.hud then self.hud:hide_popup(true); self.hud:point(nil) end
	self.board, self.queue = nil, nil
end

local function start(self, n)
	clear(self)
	self.number = n
	self.run = (self.run or 0) + 1 -- stale timers compare against this
	self.idle = 0
	self.sim = sim_mod.new(levels.get(n))
	self.L = compute_layout(self)
	self.board = board_view.new(self.sim.st, self.L)
	-- the reference reads as one open U: a closed ring compresses the inner lanes and makes
	-- distant rows overlap the head, so the queue always uses the open shape
	self.queue = queue_view.new(self.sim.st, self.L, "u")
	self.hud = self.hud or hud_mod.new(self.L)
	self.hud:relayout(self.L)
	self.vip_mode = false
	self.finished = false
	self.booster_offer = nil
	self.free_rescue = n <= FREE_RESCUE_UNTIL
	self.streak, self.last_board = 0, 0
	refresh_hud(self)
	update_tutorial(self)
	self.board:mark_free()
	if self.autoplay then -- dev: play the solver plan (headless smoke tests)
		local _, _, plan = solver.solve(self.sim.st, 30000)
		self.plan, self.plan_i, self.auto_t = plan or {}, 1, 0
	end
	if self.intro_shown ~= n then -- once per level, not on every restart
		self.intro_shown = n
		if n == 1 then self.hud:banner("MATCH THE COLOURS!", palette.CREAM) end
	end
	-- first level with a booster unlocked: explain it once (shown on the first frame, see update)
	self.pending_intro = nil
	for _, name in ipairs(hud_mod.BOOSTERS) do
		if not self.pending_intro and progress.booster_unlocked(name, n) and not progress.seen(name) then
			self.pending_intro = name
		end
	end
	self.hud:set_progress(0)
	self.departs, self.last_depart = 0, -10
	ads.measure("level", tostring(n), "start")
end

local function relayout(self)
	if not self.sim then return end
	self.L = compute_layout(self)
	self.board:relayout(self.L)
	self.queue:relayout(self.L)
	self.hud:relayout(self.L)
	update_tutorial(self)
	self.board:mark_free()
end

local function set_modal(self, title, options, info)
	self.board:set_labels(false)
	self.board:warn(false)
	self.queue:set_counter_visible(false)
	self.hud:point(nil)
	self.hud:show_popup(title, options, info)
end

local function close_modal(self)
	self.hud:hide_popup()
	self.board:set_labels(true)
	self.queue:set_counter_visible(true)
	update_tutorial(self)
end

local function offer_bay(self)
	local opts = {
		{ action = "confirm_bay", text = "+1 PARKING SLOT", icon = "icon_ad" },
		{ action = "close", text = "NO THANKS", tint = palette.BUTTON_NEUTRAL },
	}
	if progress.coins() >= config.COIN_BOOSTER then
		table.insert(opts, 2, { action = "buy_bay", text = config.COIN_BOOSTER .. " COINS", icon = "coin" })
	end
	set_modal(self, "NEED MORE SPOTS?", opts)
end

-- Out of Spots must never end without a popup: a failed or declined rescue brings it back
local function reopen_if_stuck(self)
	if self.sim.result == "stuck" and not self.finished and not self.hud:is_modal() and not self.vip_mode then
		on_stuck(self)
	end
end

-- Spend a booster; with none in stock, offer a video or coins.
local function apply_stock(self, name, apply)
	if apply() then
		progress.spend_booster(name)
		ads.measure("booster", name, "used")
	end
	refresh_hud(self)
	reopen_if_stuck(self)
end

local function with_booster(self, name, apply)
	if name == "vip" and not rules.free_bay(self.sim.st, "vip") then return end
	if progress.booster_count(name) > 0 then
		apply_stock(self, name, apply)
		return
	end
	self.booster_offer = { name = name, apply = apply }
	local opts = {
		{ action = "booster_ad", text = "WATCH A VIDEO", icon = "icon_ad" },
		{ action = "close", text = "NO THANKS", tint = palette.BUTTON_NEUTRAL },
	}
	if progress.coins() >= config.COIN_BOOSTER then
		table.insert(opts, 2, { action = "booster_coin", text = config.COIN_BOOSTER .. " COINS", icon = "coin" })
	end
	set_modal(self, "GET " .. hud_mod.NAMES[name] .. "  (" .. progress.coins() .. " COINS)", opts)
end

local function has_locked_bay(self)
	for _, bay in ipairs(self.sim.st.bays) do
		if bay.kind == "locked" then return true end
	end
	return false
end

local function has_parked(self)
	for _, bay in ipairs(self.sim.st.bays) do
		if bay.bus then return true end
	end
	return false
end

local function stock_text(name, label)
	local n = progress.booster_count(name)
	if n > 0 then return label .. " (" .. n .. ")", nil end
	return label, "icon_ad" -- none in stock: a video gives one
end

local function rescue_options(self)
	local st = self.sim.st
	local opts = {}
	if has_locked_bay(self) then
		if self.free_rescue then
			opts[#opts + 1] = { action = "rescue_free", text = "+1 SLOT  FREE" }
		else
			opts[#opts + 1] = { action = "rescue_bay", text = "+1 SLOT", icon = "icon_ad" }
		end
	end
	if has_parked(self) then
		opts[#opts + 1] = { action = "rescue_clear", text = "CLEAR SPOTS", icon = "icon_ad" }
		if progress.coins() >= config.COIN_BOOSTER then
			opts[#opts + 1] = { action = "rescue_clear_coins", text = config.COIN_BOOSTER .. " COINS", icon = "coin" }
		end
	end
	if progress.booster_unlocked("arrange", self.number) then
		local text, icon = stock_text("arrange", "SORT QUEUE")
		opts[#opts + 1] = { action = "rescue_arrange", text = text, icon = icon }
	end
	if progress.booster_unlocked("vip", self.number) and rules.free_bay(st, "vip") then
		local text, icon = stock_text("vip", "VIP BUS")
		opts[#opts + 1] = { action = "rescue_vip", text = text, icon = icon }
	end
	opts[#opts + 1] = { action = "restart", text = "RESTART", tint = palette.BUTTON_NEUTRAL }
	return opts
end

on_stuck = function(self)
	print("[game] out_of_spots " .. self.number)
	ads.gameplay_stop()
	ads.measure("level", tostring(self.number), "stuck")
	audio.play("stuck")
	set_modal(self, "OUT OF SPOTS!", rescue_options(self))
end

local function rescued(self, how)
	ads.measure("rescue", how, "used")
	close_modal(self)
end

local function on_action(self, action)
	if action == "sound" then
		local muted = not audio.is_user_muted()
		audio.set_user_muted(muted)
		progress.set_muted(muted)
		self.hud:relayout(self.L)
		audio.play("tap")
		return
	end
	if action == "restart" then
		ads.measure("level", tostring(self.number), "restart")
		start(self, self.number)
	elseif action == "close" then
		self.booster_offer = nil
		close_modal(self)
		reopen_if_stuck(self)
	elseif action == "booster_ad" then
		local offer = self.booster_offer
		self.booster_offer = nil
		if not offer then return end
		close_modal(self)
		ads.rewarded(function(ok)
			if ok and not self.finished then
				progress.add_booster(offer.name, 1)
				apply_stock(self, offer.name, offer.apply)
			else
				refresh_hud(self)
				reopen_if_stuck(self)
			end
		end)
	elseif action == "booster_coin" then
		local offer = self.booster_offer
		self.booster_offer = nil
		if not offer then return end
		close_modal(self)
		if progress.coins() >= config.COIN_BOOSTER and offer.apply() then
			progress.spend_coins(config.COIN_BOOSTER)
			ads.measure("booster", offer.name, "used")
		end
		refresh_hud(self)
		reopen_if_stuck(self)
	elseif action == "vip" then
		self.vip_mode = not self.vip_mode
		refresh_hud(self)
	elseif action == "arrange" then
		with_booster(self, "arrange", function() return self.sim:use_arrange() end)
	elseif action == "jumble" then
		with_booster(self, "jumble", function() return self.sim:use_jumble() end)
	elseif action == "rescue_free" then
		self.free_rescue = false
		self.sim:unlock_bay()
		rescued(self, "free_bay")
	elseif action == "rescue_clear" then
		ads.rewarded(function(ok)
			if ok and not self.finished and self.sim:clear_bays() then
				rescued(self, "ad_clear")
			end
		end)
	elseif action == "rescue_clear_coins" then
		if progress.coins() >= config.COIN_BOOSTER and self.sim:clear_bays() then
			progress.spend_coins(config.COIN_BOOSTER)
			self.hud:set_coins(progress.coins())
			rescued(self, "coins_clear")
		end
	elseif action == "rescue_bay" or action == "confirm_bay" then
		ads.rewarded(function(ok)
			if ok and not self.finished then
				self.sim:unlock_bay()
				if self.hud:is_modal() then rescued(self, "ad_bay") end
			elseif self.hud:is_modal() and action == "confirm_bay" then
				close_modal(self)
			end
		end)
	elseif action == "buy_bay" then
		if progress.coins() >= config.COIN_BOOSTER and self.sim:unlock_bay() then
			progress.spend_coins(config.COIN_BOOSTER)
			self.hud:set_coins(progress.coins())
			rescued(self, "coins_bay")
		end
	elseif action == "rescue_arrange" then
		close_modal(self)
		with_booster(self, "arrange", function() return self.sim:use_arrange() end)
	elseif action == "rescue_vip" then
		close_modal(self)
		local function arm()
			self.vip_mode = true
			refresh_hud(self)
			self.hud:banner("TAP ANY BUS", palette.GOLD)
		end
		if progress.booster_count("vip") > 0 then
			arm()
		else
			ads.rewarded(function(ok)
				if ok and not self.finished then
					progress.add_booster("vip", 1)
					arm()
				else
					reopen_if_stuck(self)
				end
			end)
		end
	end
end

local function jump(self, bus_id, color, from)
	local board = self.board
	local to = board:bus_world_pos(bus_id)
	to.z = from.z
	local id = factory.create(PASSENGER_FACTORY, from)
	local sprite = msg.url(nil, id, "sprite")
	local s = math.max(0.3, self.queue.size / 32)
	go.set(sprite, "scale", vmath.vector3(s, s, 1))
	go.set(sprite, "tint", palette.of(color))
	local dx, dy = to.x - from.x, to.y - from.y
	local dist = math.sqrt(dx * dx + dy * dy)
	local dur = 0.18 + math.min(0.1, dist / 2400)
	local peak = math.max(from.y, to.y) + math.max(7, dist * 0.16)
	-- a little hop out of the queue, then a dive into the bus
	go.set(id, "euler.z", math.deg(math.atan2(dy, dx)))
	go.animate(id, "euler.z", go.PLAYBACK_ONCE_FORWARD, math.deg(math.atan2(dy, dx)) + 110, go.EASING_OUTQUAD, dur)
	go.animate(id, "position.x", go.PLAYBACK_ONCE_FORWARD, to.x, go.EASING_INOUTQUAD, dur)
	go.animate(id, "position.y", go.PLAYBACK_ONCE_FORWARD, peak, go.EASING_OUTQUAD, dur * 0.55, 0, function()
		if not go.exists(id) then return end
		go.animate(id, "position.y", go.PLAYBACK_ONCE_FORWARD, to.y, go.EASING_INQUAD, dur * 0.45)
	end)
	go.set_scale(0.55, id)
	go.animate(id, "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(1.25, 1.25, 1), go.EASING_OUTBACK, dur * 0.42, 0, function()
		if not go.exists(id) then return end
		go.animate(id, "scale", go.PLAYBACK_ONCE_FORWARD, vmath.vector3(0.42, 0.42, 1), go.EASING_INQUAD, dur * 0.58, 0, function()
			if go.exists(id) then go.delete(id) end
			if self.board == board then board:board_impact(bus_id, color) end
		end)
	end)
end

local function spark()
	local id = factory.create(TILE_FACTORY, vmath.vector3(0, 0, 0.95))
	sprite.play_flipbook(msg.url(nil, id, "sprite"), "spark")
	return id
end

local function on_won(self)
	self.finished = true
	if self.hud:is_modal() then close_modal(self) end
	ads.gameplay_stop()
	ads.measure("level", tostring(self.number), "complete")
	print("[game] level_complete " .. self.number)
	audio.play("win")
	self.hud:point(nil)
	if self.number >= 2 then progress.set_tutorial_done() end
	progress.complete_level(self.number)
	progress.add_coins(config.COIN_REWARD)
	self.hud:set_coins(progress.coins())
	ads.measure("coins", "level", tostring(config.COIN_REWARD))
	local L = self.L
	self.hud:banner("LEVEL COMPLETE!", palette.GOLD)
	juice.confetti(L.loop.x + L.loop.w * 0.5, L.loop.y + L.loop.h * 0.5, 36, math.max(10, L.unit * 0.5), palette.COLORS, spark)
	local level_done, run = self.number, self.run
	timer.delay(config.NEXT_LEVEL_DELAY, false, function()
		if self.run ~= run then return end -- restarted meanwhile
		ads.level_break(level_done, function() start(self, level_done + 1) end)
	end)
end

-- Quick chains of departures earn praise (NICE! -> AMAZING!) above the pier
local PRAISE = { "NICE!", "GREAT!", "AWESOME!", "AMAZING!" }
local function praise_chain(self)
	local now = self.sim.time
	self.departs = (now - self.last_depart < 1.8) and self.departs + 1 or 1
	self.last_depart = now
	local text = PRAISE[math.min(self.departs - 1, #PRAISE)]
	if text and not self.hud:is_modal() then
		local b = self.L.bays
		self.hud:praise(text, b.x + b.w * 0.5, b.y - self.L.unit * 1.8) -- just below the pier
		audio.play("unlock", 1 + self.departs * 0.08, 0.6)
	end
end

local BOOSTER_INFO = {
	vip = { title = "NEW: VIP", icon = "icon_vip", lines = { "SEND ANY BUS,", "EVEN A BLOCKED ONE" } },
	arrange = { title = "NEW: SORT", icon = "icon_arrange", lines = { "SEATED PASSENGERS", "GO FIRST" } },
	jumble = { title = "NEW: MIX", icon = "icon_jumble", lines = { "SHUFFLE COLOURS", "OF PARKED BUSES" } },
}

local function show_intro(self)
	local name = self.pending_intro
	self.pending_intro = nil
	progress.set_seen(name)
	local info = BOOSTER_INFO[name]
	set_modal(self, info.title, { { action = "close", text = "GOT IT" } },
		{ icon = info.icon, tint = palette.BUTTONS[name], lines = info.lines })
end

local function on_event(self, ev)
	self.board:on_event(ev)
	local t = ev.type
	if t == "board" then
		local from = self.queue:head_pos()
		self.queue:on_board()
		self.hud:set_progress((self.sim.st.head - 1) / #self.sim.st.queue)
		jump(self, ev.bus, ev.color, from)
		local now = self.sim.time
		self.streak = (now - self.last_board < 0.3) and math.min(self.streak + 1, 20) or 0
		self.last_board = now
		audio.play("board", 1 + self.streak * 0.05)
	elseif t == "depart" then
		praise_chain(self)
	elseif t == "won" and not self.finished then
		on_won(self)
	elseif t == "stuck" then
		on_stuck(self)
	end
end

function init(self)
	msg.post(".", "acquire_input_focus")
	progress.load()
	audio.set_user_muted(progress.muted())
	ads.set_hooks(function() audio.set_muted(true) end, function() audio.set_muted(false) end)
	window.set_listener(function(_, event)
		if event == window.WINDOW_EVENT_RESIZED then relayout(self) end
	end)
	-- dev: dmengine --config=bus.start_level=18 opens any level (progress still saves on win)
	self.autoplay = sys.get_config_int("bus.autoplay", 0) == 1
	local dev_level = sys.get_config_int("bus.start_level", 0)
	start(self, dev_level > 0 and dev_level or progress.level())
	-- dev: --config=bus.dev_popup=1 opens Out of Spots, =2 the "+" bay offer (screenshots)
	print("[game] ready")
	local dev_popup = sys.get_config_int("bus.dev_popup", 0)
	if dev_popup == 1 then on_stuck(self) end
	if dev_popup == 2 then offer_bay(self) end
end

-- One step from Out of Spots (one open bay left, nothing for the head): pulse the "+" bays
local function update_warning(self)
	local st = self.sim.st
	local free, match = 0, false
	local head = st.queue[st.head]
	for _, bay in ipairs(st.bays) do
		local b = bay.bus and st.buses[bay.bus]
		if bay.kind == "open" and not b then free = free + 1 end
		if b and b.color == head then match = true end
	end
	self.board:warn(free == 1 and not match and not self.finished and not self.hud:is_modal())
end

local function autoplay(self, dt)
	if not self.autoplay or self.finished or self.hud:is_modal() then return end
	self.auto_t = self.auto_t + dt
	if self.auto_t < 0.35 then return end
	local st = self.sim.st
	local id = self.plan[self.plan_i]
	local bus = id and st.buses[id]
	if bus and bus.state ~= "lot" then
		self.plan_i = self.plan_i + 1
	elseif bus and rules.free_bay(st, "open") then
		self.auto_t = 0
		self.sim:tap(id, function(bay) return self.board:travel_time(id, bay) end)
	end
end

function update(self, dt)
	if ads.is_ad_active() or not self.sim then return end
	if self.pending_intro and not self.hud:is_modal() and not self.finished and not self.autoplay then show_intro(self) end
	autoplay(self, dt)
	self.sim:update(dt)
	self.board:update(dt)
	local events = self.sim:drain()
	for _, ev in ipairs(events) do on_event(self, ev) end
	local was_idle = (self.idle or 0) > IDLE_HINT
	self.idle = (self.idle or 0) + dt
	if #events > 0 or (not was_idle and self.idle > IDLE_HINT) then
		update_tutorial(self)
		update_warning(self)
		self.board:mark_free()
	end
	self.queue:update(dt)
end

function on_input(self, action_id, action)
	if action_id ~= TOUCH or not action.pressed or ads.is_ad_active() then return end
	local x, y = action.screen_x, action.screen_y
	self.hud:ripple(x, y)
	if (self.idle or 0) > IDLE_HINT then
		self.idle = 0
		update_tutorial(self)
	end
	self.idle = 0

	if self.finished then return true end -- level done: wait for the next one
	ads.gameplay_start() -- first player input (again after a popup or an ad)
	local act = self.hud:pick(x, y)
	if act then
		if act ~= "popup_miss" and act ~= "locked" then on_action(self, act) end
		return true
	end

	local bay = self.board:pick_bay(x, y)
	if bay and self.sim.st.bays[bay].kind == "locked" then
		offer_bay(self)
		return true
	end

	local bus = self.board:pick(x, y)
	if not bus then return end
	if self.vip_mode then
		with_booster(self, "vip", function() return self.sim:use_vip(bus) end)
		self.vip_mode = false
		refresh_hud(self)
	else
		self.sim:tap(bus, function(bay) return self.board:travel_time(bus, bay) end)
	end
	return true
end
